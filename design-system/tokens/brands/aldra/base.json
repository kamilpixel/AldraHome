{
  "$extensions": {
    "com.aldrahome.brand": {
      "name": "Aldra",
      "tagline": "Calm Scandinavian flagship",
      "description": "The group's flagship brand. Soft geometry, pine green and warm clay: quiet confidence for everyday living.",
      "product": "Aldra Home"
    }
  },
  "brand": {
    "font": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Manrope",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "Manrope",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      }
    },
    "radius": {
      "$type": "dimension",
      "$description": "item \u2192 rounded-sm, control \u2192 rounded-md, panel \u2192 rounded-lg, card \u2192 rounded-xl",
      "item": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      },
      "control": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "panel": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "card": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      }
    }
  }
}