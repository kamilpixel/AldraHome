{
  "$extensions": {
    "com.aldrahome.brand": {
      "name": "Veyra",
      "tagline": "Premium dark-metal line",
      "description": "The group's premium line. Sharp geometry, deep ink and brushed brass: crafted appliances for considered kitchens.",
      "product": "Veyra Home"
    }
  },
  "brand": {
    "font": {
      "$type": "fontFamily",
      "body": {
        "$value": [
          "Manrope",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "display": {
        "$value": [
          "Fraunces",
          "ui-serif",
          "Georgia",
          "serif"
        ]
      }
    },
    "radius": {
      "$type": "dimension",
      "$description": "item → rounded-sm, control → rounded-md, panel → rounded-lg, card → rounded-xl",
      "item": {
        "$value": {
          "value": 2,
          "unit": "px"
        }
      },
      "control": {
        "$value": {
          "value": 4,
          "unit": "px"
        }
      },
      "panel": {
        "$value": {
          "value": 6,
          "unit": "px"
        }
      },
      "card": {
        "$value": {
          "value": 8,
          "unit": "px"
        }
      }
    }
  }
}